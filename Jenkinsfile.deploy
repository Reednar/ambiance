node {
    // Define environment variables
    def NODE_VERSION = '22.11.0'
    def NPM_VERSION = '10.8.3'
    def FRONT_DIR = '/var/www/AM-FRONT'
    def BACK_DIR = '/var/www/AM-BACK'

    // Use credentials for sensitive data
    withCredentials([
        string(credentialsId: 'DATABASE_HOST', variable: 'DATABASE_HOST'),
        string(credentialsId: 'DATABASE_PORT', variable: 'DATABASE_PORT'),
        string(credentialsId: 'DATABASE_USER', variable: 'DATABASE_USER'),
        string(credentialsId: 'DATABASE_PASSWORD', variable: 'DATABASE_PASSWORD'),
        string(credentialsId: 'DATABASE_NAME', variable: 'DATABASE_NAME'),
        string(credentialsId: 'PORT', variable: 'PORT')
    ]) {

        stage('Checkout') {
            script {
                def startCheckout = new Date()
                echo "🔧 Checkout started at: ${startCheckout}"
            }
            git branch: 'develop', url: 'git@github.com:Reednar/ambiance.git'
            script {
                def endCheckout = new Date()
                echo "✅ Checkout done at: ${endCheckout} (Duration: ${(endCheckout.time - startCheckout.time)/1000} sec)"
            }
        }

        stage('Setup Environment') {
            script {
                def startSetupEnv = new Date()
                echo "🔧 Setup Environment started at: ${startSetupEnv}"
            }
            sh '''
                export NVM_DIR="$HOME/.nvm"
                [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                echo "Using Node.js version: $(node -v)"
                echo "Using npm version: $(npm -v)"
            '''
            script {
                def endSetupEnv = new Date()
                echo "✅ Setup Environment done at: ${endSetupEnv} (Duration: ${(endSetupEnv.time - startSetupEnv.time)/1000} sec)"
            }
        }

        stage('Install Dependencies') {
            parallel(
                "Install Frontend Dependencies": {
                    script {
                        def startFrontendInstall = new Date()
                        echo "🔧 Frontend dependencies installation started at: ${startFrontendInstall}"
                    }
                    sh 'cd ambiance-front && npm ci --prefer-offline'
                    script {
                        def endFrontendInstall = new Date()
                        echo "✅ Frontend dependencies installed at: ${endFrontendInstall} (Duration: ${(endFrontendInstall.time - startFrontendInstall.time)/1000} sec)"
                    }
                },
                "Install Backend Dependencies": {
                    script {
                        def startBackendInstall = new Date()
                        echo "🔧 Backend dependencies installation started at: ${startBackendInstall}"
                    }
                    sh 'cd ambiance-back && npm ci'
                    script {
                        def endBackendInstall = new Date()
                        echo "✅ Backend dependencies installed at: ${endBackendInstall} (Duration: ${(endBackendInstall.time - startBackendInstall.time)/1000} sec)"
                    }
                }
            )
        }

        stage('Build Projects') {
            parallel(
                "Build Angular Frontend": {
                    script {
                        def startFrontendBuild = new Date()
                        echo "🔧 Angular frontend build started at: ${startFrontendBuild}"
                    }
                    sh 'cd ambiance-front && npm run build'
                    script {
                        def endFrontendBuild = new Date()
                        echo "✅ Angular frontend build completed at: ${endFrontendBuild} (Duration: ${(endFrontendBuild.time - startFrontendBuild.time)/1000} sec)"
                    }
                },
                "Build NestJS Backend": {
                    script {
                        def startBackendBuild = new Date()
                        echo "🔧 NestJS backend build started at: ${startBackendBuild}"
                    }
                    sh 'cd ambiance-back && npm run build'
                    script {
                        def endBackendBuild = new Date()
                        echo "✅ NestJS backend build completed at: ${endBackendBuild} (Duration: ${(endBackendBuild.time - startBackendBuild.time)/1000} sec)"
                    }
                }
            )
        }

        stage('Deploy Angular') {
            script {
                def startDeployFrontend = new Date()
                echo "🔧 Angular deployment started at: ${startDeployFrontend}"
            }
            sh """
                rm -rf ${FRONT_DIR}/*
                cp -r ambiance-front/dist/* ${FRONT_DIR}/
            """
            script {
                def endDeployFrontend = new Date()
                echo "✅ Angular deployment completed at: ${endDeployFrontend} (Duration: ${(endDeployFrontend.time - startDeployFrontend.time)/1000} sec)"
            }
        }

        stage('Deploy NestJS') {
            script {
                def startDeployBackend = new Date()
                echo "🔧 NestJS deployment started at: ${startDeployBackend}"
            }
            sh """
                rm -rf ${BACK_DIR}/*
                cp -r ambiance-back/dist/* ${BACK_DIR}/
                cp ambiance-back/package*.json ${BACK_DIR}/
            """
            script {
                def endDeployBackend = new Date()
                echo "✅ NestJS deployment completed at: ${endDeployBackend} (Duration: ${(endDeployBackend.time - startDeployBackend.time)/1000} sec)"
            }
        }

        stage('Install Backend Production Dependencies') {
            script {
                def startBackendProdInstall = new Date()
                echo "🔧 Backend production dependencies installation started at: ${startBackendProdInstall}"
            }
            sh """
                cd ${BACK_DIR}
                npm ci --omit=dev
            """
            script {
                def endBackendProdInstall = new Date()
                echo "✅ Backend production dependencies installed at: ${endBackendProdInstall} (Duration: ${(endBackendProdInstall.time - startBackendProdInstall.time)/1000} sec)"
            }
        }

        stage('Inject .env') {
            script {
                def startInjectEnv = new Date()
                echo "🔧 Injecting .env started at: ${startInjectEnv}"
            }
            sh """
                rm -f ${BACK_DIR}/.env
                cat <<EOF > ${BACK_DIR}/.env
PORT=${PORT}
DATABASE_HOST=${DATABASE_HOST}
DATABASE_PORT=${DATABASE_PORT}
DATABASE_USER=${DATABASE_USER}
DATABASE_PASSWORD=${DATABASE_PASSWORD}
DATABASE_NAME=${DATABASE_NAME}
EOF
            """
            script {
                def endInjectEnv = new Date()
                echo "✅ .env injected at: ${endInjectEnv} (Duration: ${(endInjectEnv.time - startInjectEnv.time)/1000} sec)"
            }
        }

        stage('Restart NestJS') {
            script {
                def startRestartNestJS = new Date()
                echo "🔧 Restarting NestJS started at: ${startRestartNestJS}"
            }
            sh """
                cd ${BACK_DIR}
                if pm2 describe nestjs > /dev/null; then
                    pm2 restart nestjs --update-env --cwd ${BACK_DIR}
                else
                    pm2 start main.js --name nestjs --cwd ${BACK_DIR} --interpreter \$(which node)
                fi
                pm2 save
            """
            script {
                def endRestartNestJS = new Date()
                echo "✅ Restarted NestJS at: ${endRestartNestJS} (Duration: ${(endRestartNestJS.time - startRestartNestJS.time)/1000} sec)"
            }
        }
    }
}
