node {
    // Déclaration des variables d'environnement
    def SONARQUBE_SERVER = 'https://sonarqube.ambiance-ensitech.me'
    def SONAR_TOKEN = credentials('sonar-token')

    stage('Checkout') {
        git 'https://github.com/Reednar/ambiance.git'
    }

    stage('SonarQube Analysis') {
        withSonarQubeEnv('SonarQubeServer') {
            sh """#!/bin/bash
                export SONARQUBE_SERVER="${SONARQUBE_SERVER}"
                export SONAR_TOKEN="${SONAR_TOKEN}"
                export CHANGE_BRANCH="${env.CHANGE_BRANCH}"

                sonar-scanner \\
                  -Dsonar.projectKey=Ambiance \\
                  -Dsonar.projectName=Ambiance \\
                  -Dsonar.host.url="\$SONARQUBE_SERVER" \\
                  -Dsonar.login="\$SONAR_TOKEN" \\
                  -Dsonar.branch.name="\$CHANGE_BRANCH"
            """
        }
    }

    stage('Quality Gate') {
        timeout(time: 1, unit: 'MINUTES') {
            waitForQualityGate abortPipeline: true
        }
    }

    stage('Cleanup') {
        cleanWs()
    }
}
