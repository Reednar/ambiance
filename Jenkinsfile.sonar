node {
    def SONARQUBE_SERVER = 'https://sonarqube.ambiance-ensitech.me'
    def SONAR_TOKEN = credentials('sonar-token')
    def secretWebhook = credentials('secret-webhook-sonarqube')

    stage('Checkout') {
        git 'https://github.com/Reednar/ambiance.git'
    }

    stage('SonarQube Analysis') {
        echo "🧪 BRANCH_NAME = ${env.BRANCH_NAME}"

        if (env.BRANCH_NAME == 'develop' || env.BRANCH_NAME.startsWith('PR-')) {
            withSonarQubeEnv('SonarQubeServer') {
                sh """
                    sonar-scanner \\
                    -Dsonar.projectKey=ambiance-develop \\
                    -Dsonar.projectName=ambiance-develop \\
                    -Dsonar.host.url=${SONARQUBE_SERVER} \\
                    -Dsonar.sources=. \\
                    -Dsonar.java.binaries=build \\
                    -Dsonar.newCode.period=30
                """
            }
        } else {
            echo "⏩ Skipping SonarQube analysis (non-develop/non-PR branch)"
        }
    }

    stage('Quality Gate') {
        if (env.BRANCH_NAME == 'develop' || env.BRANCH_NAME.startsWith('PR-')) {
            timeout(time: 5, unit: 'MINUTES') {
                waitForQualityGate abortPipeline: true
            }
        } else {
            echo "⏩ Skipping Quality Gate (non-develop/non-PR branch)"
        }
    }

    stage('Cleanup') {
        cleanWs()
    }
}
