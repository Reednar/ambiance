node {
    // Déclaration des variables d'environnement
    def SONARQUBE_SERVER = 'https://sonarqube.ambiance-ensitech.me'
    def SONAR_TOKEN = credentials('sonar-token')
    def secretWebhook = credentials('secret-webhook-sonarqube')

    stage('Checkout') {
        checkout([$class: 'GitSCM',
            branches: [[name: '*/develop']],
            userRemoteConfigs: [[url: 'https://github.com/Reednar/ambiance.git']]
        ])
    }

    stage('SonarQube Analysis') {
        echo "🧪 BRANCH_NAME = ${env.BRANCH_NAME}"
        // Vérifie si on est sur la branche develop
        if (env.BRANCH_NAME == 'develop') {
            withSonarQubeEnv('SonarQubeServer') {
                sh """
                    sonar-scanner \\
                    -Dsonar.projectKey=ambiance-develop \\
                    -Dsonar.projectName=ambiance-develop \\
                    -Dsonar.host.url=${SONARQUBE_SERVER} \\
                    -Dsonar.sources=. \\
                    -Dsonar.java.binaries=build \\
                    -Dsonar.newCode.period=30
                """
            }
        } else {
            echo "🔁 Skipping SonarQube analysis (current branch: ${env.BRANCH_NAME})"
        }
    }

    stage('Quality Gate') {
        // Ne passe le quality gate que si analyse effectuée
        if (env.BRANCH_NAME == 'develop') {
            timeout(time: 5, unit: 'MINUTES') {
                waitForQualityGate abortPipeline: true
            }
        } else {
            echo "⏩ Skipping Quality Gate (non-develop branch)"
        }
    }

    stage('Cleanup') {
        cleanWs()
    }
}
