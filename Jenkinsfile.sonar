node {
    def SONARQUBE_SERVER = 'https://sonarqube.ambiance-ensitech.me'
    def SONAR_TOKEN = credentials('sonar-token')
    def secretWebhook = credentials('secret-webhook-sonarqube')

    // Récupération de la branche cible de la PR
    def currentBranch = env.BRANCH_NAME
    def targetBranch = sh(script: "git rev-parse --abbrev-ref HEAD", returnStdout: true).trim()
    
    // Affichage des informations de branche pour le débogage
    echo "🧪 Current Branch: ${currentBranch}"
    echo "🧪 Target Branch (PR): ${targetBranch}"

    stage('Checkout') {
        // On fait un checkout de la branche spécifique de la PR
        checkout scm
    }

    stage('SonarQube Analysis') {
        // L'analyse est lancée uniquement si la branche est 'develop' ou une PR vers 'develop'
        if (currentBranch == 'develop' || currentBranch.startsWith('PR-')) {
            withSonarQubeEnv('SonarQubeServer') {
                sh """
                    sonar-scanner \\
                    -Dsonar.projectKey=ambiance \\
                    -Dsonar.projectName=ambiance \\
                    -Dsonar.host.url=${SONARQUBE_SERVER} \\
                    -Dsonar.sources=. \\
                    -Dsonar.java.binaries=build \\
                    -Dsonar.newCode.period=30
                """
            }
        } else {
            echo "⏩ Skipping SonarQube analysis (non-develop/non-PR branch)"
        }
    }

    stage('Quality Gate') {
        if (currentBranch == 'develop' || currentBranch.startsWith('PR-')) {
            timeout(time: 5, unit: 'MINUTES') {
                waitForQualityGate abortPipeline: true
            }
        } else {
            echo "⏩ Skipping Quality Gate (non-develop/non-PR branch)"
        }
    }

    stage('Cleanup') {
        cleanWs()
    }
}
